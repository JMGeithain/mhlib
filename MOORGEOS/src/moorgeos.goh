    @message void MSG_MOORGEOS_TIMER_TICK();

    @instance word MGBI_score = 0;
    @instance word MGBI_misses = 0;
    @instance byte MGBI_secondsLeft = 60;
    @instance word MGBI_bird0X = 28;
    @instance word MGBI_bird1X = 174;
    @instance word MGBI_bird2X = 320;
    @instance byte MGBI_bird0Right = 1;
    @instance byte MGBI_bird1Right = 0;
    @instance byte MGBI_bird2Right = 1;
    @instance word MGBI_bird0Y = 66;
    @instance word MGBI_bird1Y = 82;
    @instance word MGBI_bird2Y = 56;
    @instance byte MGBI_bird0Down = 1;
    @instance byte MGBI_bird1Down = 0;
    @instance byte MGBI_bird2Down = 1;
    @instance word MGBI_timerID = 0;
    @instance word MGBI_timerHandle = 0;
    @instance byte MGBI_gameActive = 0;
    @instance byte MGBI_gameFinished = 0;
    @instance byte MGBI_lastShotState = 0;
@endc
