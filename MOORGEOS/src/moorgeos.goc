@object MoorGEOSBoardClass MoorGEOSBoard = {
    VI_bounds = {0, 0, 400, 260};
}

@end BoardBlock;

/* Transparent 16x16 system pointer: mask=0/image=0 leaves the screen unchanged.
 * The larger 32-unit crosshair remains drawn by the application in MSG_VIS_DRAW. */
@start CursorResource, data;
@chunk PointerDef16 MoorGEOSInvisiblePointer = {
    16, 16, 7, 7,
    { /* 32-byte mask: all zero = no pointer pixels */
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
    },
    { /* 32-byte image: all zero */
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
    }
};
@end CursorResource;

/* The former system-pointer resource was removed. The crosshair is drawn
 * by MSG_VIS_DRAW, so no CursorResource or video-driver pointer is needed. */


/*
 * Draw the playfield and the imported Moorhuhn bitmap sprite.
 */
@method MoorGEOSBoardClass, MSG_VIS_DRAW
{
    word birdX;
    word birdY;
    byte birdState;
    byte birdIndex;
    void *birdGraphicData;
    Handle birdGString;

    GrSetMixMode(gstate, MM_COPY);

    /* Sky and grass. */
    GrSetAreaColor(gstate, CF_INDEX, C_CYAN, 0, 0);
    GrFillRect(gstate, 0, 0, 399, 159);

    GrSetAreaColor(gstate, CF_INDEX, C_GREEN, 0, 0);
    GrFillRect(gstate, 0, 160, 399, 259);

    /* A simple sun and two ground lines make the scene easier to read. */
    GrSetAreaColor(gstate, CF_INDEX, C_YELLOW, 0, 0);
    GrFillEllipse(gstate, 286, 46, 321, 81); /* 36x36 instead of 28x28 */

    GrSetLineColor(gstate, CF_INDEX, C_GREEN, 0, 0);
    GrDrawHLine(gstate, 0, 168, 399);
    GrDrawHLine(gstate, 0, 214, 399);

    /* Give the three HUD rows clear spacing and padding on every side. */
    GrSetAreaColor(gstate, CF_INDEX, C_BLACK, 0, 0);
    GrFillRect(gstate, 0, 4, 132, 59);
    GrSetTextColor(gstate, CF_INDEX, C_WHITE, 0, 0);
    GrDrawText(gstate, 10, 10, "Punkte", 6);
    GrDrawText(gstate, 10, 26, "Fehler", 6);
    GrDrawText(gstate, 10, 42, "Zeit", 4);
    {
        word i;
        word scoreValue = pself->MGBI_score;
        word missesValue = pself->MGBI_misses;
        word secondsValue = pself->MGBI_secondsLeft;
        char digitText[2];
        /* Five score digits, including leading zeroes, fit inside the panel. */
        GrSetTextColor(gstate, CF_INDEX, C_YELLOW, 0, 0);
        for (i = 0; i < 5; i++) {
            word divisor = 1;
            word j;
            for (j = i + 1; j < 5; j++) divisor *= 10;
            digitText[0] = '0' + ((scoreValue / divisor) % 10);
            digitText[1] = 0;
            GrDrawText(gstate, 76 + (i * 8), 10, digitText, 1);
        }
        /* Miss count is capped visually at 99 to keep the panel compact. */
        if (missesValue > 99) missesValue = 99;
        GrSetTextColor(gstate, CF_INDEX, C_LIGHT_RED, 0, 0);
        digitText[0] = '0' + ((missesValue / 10) % 10);
        digitText[1] = 0;
        GrDrawText(gstate, 76, 26, digitText, 1);
        digitText[0] = '0' + (missesValue % 10);
        GrDrawText(gstate, 84, 26, digitText, 1);
        GrSetTextColor(gstate, CF_INDEX, C_WHITE, 0, 0);
        digitText[0] = '0' + ((secondsValue / 10) % 10);
        GrDrawText(gstate, 76, 42, digitText, 1);
        digitText[0] = '0' + (secondsValue % 10);
        GrDrawText(gstate, 84, 42, digitText, 1);
    }

    /* Load, draw, and release a fresh GString for each chicken. */
    for (birdIndex = 0; birdIndex < 3; birdIndex++) {
        switch (birdIndex) {
            case 0:
                birdX = pself->MGBI_bird0X; birdY = pself->MGBI_bird0Y;
                birdState = pself->MGBI_bird0State; break;
            case 1:
                birdX = pself->MGBI_bird1X; birdY = pself->MGBI_bird1Y;
                birdState = pself->MGBI_bird1State; break;
            default:
                birdX = pself->MGBI_bird2X; birdY = pself->MGBI_bird2Y;
                birdState = pself->MGBI_bird2State; break;
        }
        /* State 2 is the short pause after the bird has reached the ground. */
        if (birdState != 2) {
            birdGraphicData = LMemDerefHandles(OptrToHandle(oself), @MoorGEOSBirdGraphic);
            birdGString = GrLoadGString(PtrToSegment(birdGraphicData), GST_PTR,
                                          PtrToOffset(birdGraphicData));
            GrDrawGString(gstate, birdGString, birdX, birdY, 0, (word*)0);
            GrDestroyGString(birdGString, 0, GSKT_LEAVE_DATA);

            /* A falling bird gets a clearly different hit-state symbol:
             * a dark-edged red X over its body. */
            if (birdState == 1) {
                GrSetLineColor(gstate, CF_INDEX, C_BLACK, 0, 0);
                GrDrawLine(gstate, birdX + 18, birdY + 34,
                           birdX + 34, birdY + 50);
                GrDrawLine(gstate, birdX + 34, birdY + 34,
                           birdX + 18, birdY + 50);
                GrSetLineColor(gstate, CF_INDEX, C_LIGHT_RED, 0, 0);
                GrDrawLine(gstate, birdX + 19, birdY + 34,
                           birdX + 34, birdY + 49);
                GrDrawLine(gstate, birdX + 34, birdY + 34,
                           birdX + 19, birdY + 49);
            }
        }
    }

    /* Context message: show the player how to start or restart. */
    if (!pself->MGBI_gameActive && !pself->MGBI_gameFinished) {
        GrSetAreaColor(gstate, CF_INDEX, C_BLACK, 0, 0);
        GrFillRect(gstate, 96, 225, 300, 249);
        GrSetTextColor(gstate, CF_INDEX, C_WHITE, 0, 0);
        GrDrawText(gstate, 118, 232, "KLICK ZUM START", 15);
    } else if (pself->MGBI_gameActive && pself->MGBI_lastShotState != 0) {
        GrSetAreaColor(gstate, CF_INDEX, C_BLACK, 0, 0);
        GrFillRect(gstate, 138, 225, 258, 249);
        if (pself->MGBI_lastShotState == 1) {
            GrSetTextColor(gstate, CF_INDEX, C_YELLOW, 0, 0);
            GrDrawText(gstate, 166, 232, "TREFFER!", 8);
        } else {
            GrSetTextColor(gstate, CF_INDEX, C_LIGHT_RED, 0, 0);
            GrDrawText(gstate, 168, 232, "DANEBEN", 7);
        }
    }

    /* Clear end-of-round message over the playfield when the clock expires. */
    if (pself->MGBI_gameFinished) {
        GrSetAreaColor(gstate, CF_INDEX, C_BLACK, 0, 0);
        GrFillRect(gstate, 126, 188, 270, 216);
        GrSetTextColor(gstate, CF_INDEX, C_WHITE, 0, 0);
        GrDrawText(gstate, 144, 195, "SPIEL VORBEI", 12);
        GrDrawText(gstate, 118, 232, "NEUES SPIEL IM MENUE", 19);
    }

    @callsuper();

    /* Application-level 32-unit crosshair; no video-driver pointer change. */
    if (pself->MGBI_crosshairVisible) {
        sword cx = pself->MGBI_crosshairX;
        sword cy = pself->MGBI_crosshairY;

        /* Dark underlay keeps the sight visible against sky and sprites. */
        GrSetLineColor(gstate, CF_INDEX, C_BLACK, 0, 0);
        GrDrawLine(gstate, cx - 16, cy, cx - 5, cy);
        GrDrawLine(gstate, cx + 5, cy, cx + 16, cy);
        GrDrawLine(gstate, cx, cy - 16, cx, cy - 5);
        GrDrawLine(gstate, cx, cy + 5, cx, cy + 16);
        GrDrawEllipse(gstate, cx - 5, cy - 5, cx + 5, cy + 5);

        /* Bright inner strokes form the visible reticle. */
        GrSetLineColor(gstate, CF_INDEX, C_WHITE, 0, 0);
        GrDrawLine(gstate, cx - 15, cy, cx - 6, cy);
        GrDrawLine(gstate, cx + 6, cy, cx + 15, cy);
        GrDrawLine(gstate, cx, cy - 15, cx, cy - 6);
        GrDrawLine(gstate, cx, cy + 6, cx, cy + 15);
        GrDrawEllipse(gstate, cx - 4, cy - 4, cx + 4, cy + 4);
    }
}

/* Track pointer movement in the board without taking a permanent mouse grab. */
@method MoorGEOSBoardClass, MSG_META_PTR
{
    if (pself->MGBI_gameActive) {
        if ((pself->MGBI_crosshairX != xPosition) ||
            (pself->MGBI_crosshairY != yPosition)) {
            sword oldX = pself->MGBI_crosshairX;
            sword oldY = pself->MGBI_crosshairY;
            /* Mouse coordinates and update rectangles are document coordinates.
             * Add a one-unit safety margin around the 32-unit reticle. */
            @send self::MSG_VIS_ADD_RECT_TO_UPDATE_REGION(0, 0,
                oldY + 17, oldX + 17, oldY - 17, oldX - 17);
            pself->MGBI_crosshairX = xPosition;
            pself->MGBI_crosshairY = yPosition;
            @send self::MSG_VIS_ADD_RECT_TO_UPDATE_REGION(0, 0,
                yPosition + 17, xPosition + 17, yPosition - 17, xPosition - 17);
        }
        retVal->flags = MRF_PROCESSED;
    }
}

/* Start the round clock only once the player first clicks the board. */
@method MoorGEOSBoardClass, MSG_META_START_SELECT
{
    byte hitTarget = 0;
    byte hitBird = 255;

    /* Prepare the GEOS gunshot instrument once, then reuse its sound handle. */
    if (MoorGEOSGunshot == NullHandle) {
        SoundAllocMusicNote(IP_GUNSHOT, 0, MIDDLE_C,
                            DYNAMIC_FFFF, SSDTT_TEMPO, QUARTER,
                            &MoorGEOSGunshot);
    }
    if (MoorGEOSGunshot != NullHandle) {
        UserStandardSound(SST_CUSTOM_SOUND, MoorGEOSGunshot, 1);
    }

    if (pself->MGBI_gameFinished) {
        retVal->flags = MRF_PROCESSED;
        return;
    }

    if (!pself->MGBI_gameActive) {
        pself->MGBI_gameActive = 1;
        pself->MGBI_secondsLeft = 60;

        /* The first click also establishes the initial app-drawn reticle. */
        pself->MGBI_crosshairX = xPosition;
        pself->MGBI_crosshairY = yPosition;
        pself->MGBI_crosshairVisible = 1;

        /* Hide the normal system pointer only inside the game view. */
        MemLock(OptrToHandle(@MoorGEOSInvisiblePointer));
        @call MoorGEOSView::MSG_GEN_VIEW_SET_PTR_IMAGE(
            @MoorGEOSInvisiblePointer, PIL_WINDOW);
        MemUnlock(OptrToHandle(@MoorGEOSInvisiblePointer));

        pself->MGBI_timerHandle = TimerStart(
            TIMER_EVENT_CONTINUAL, oself, 60,
            MSG_MOORGEOS_TIMER_TICK, 60,
            &pself->MGBI_timerID);
    }

    /* A falling or hidden bird cannot be hit again. Remember exactly which
     * live sprite was hit so only that bird starts the fall sequence. */
    if ((pself->MGBI_bird0State == 0) &&
        (xPosition >= pself->MGBI_bird0X) &&
        (xPosition <= pself->MGBI_bird0X + 51) &&
        (yPosition >= pself->MGBI_bird0Y) &&
        (yPosition <= pself->MGBI_bird0Y + 69)) {
        hitBird = 0;
    } else if ((pself->MGBI_bird1State == 0) &&
        (xPosition >= pself->MGBI_bird1X) &&
        (xPosition <= pself->MGBI_bird1X + 51) &&
        (yPosition >= pself->MGBI_bird1Y) &&
        (yPosition <= pself->MGBI_bird1Y + 69)) {
        hitBird = 1;
    } else if ((pself->MGBI_bird2State == 0) &&
        (xPosition >= pself->MGBI_bird2X) &&
        (xPosition <= pself->MGBI_bird2X + 51) &&
        (yPosition >= pself->MGBI_bird2Y) &&
        (yPosition <= pself->MGBI_bird2Y + 69)) {
        hitBird = 2;
    }
    if (hitBird != 255) {
        hitTarget = 1;
        switch (hitBird) {
            case 0:
                pself->MGBI_bird0State = 1;
                pself->MGBI_bird0Respawn = 0;
                break;
            case 1:
                pself->MGBI_bird1State = 1;
                pself->MGBI_bird1Respawn = 0;
                break;
            default:
                pself->MGBI_bird2State = 1;
                pself->MGBI_bird2Respawn = 0;
                break;
        }
        /* Delay the cry briefly so it follows, rather than masks, the shot. */
        pself->MGBI_screamDelay = 2;
        /* Animate the fall at six frames per second; the game clock remains
         * on its independent one-second timer. */
        if (pself->MGBI_fallTimerHandle == 0) {
            pself->MGBI_fallTimerHandle = TimerStart(
                TIMER_EVENT_CONTINUAL, oself, 10,
                MSG_MOORGEOS_FALL_TICK, 10,
                &pself->MGBI_fallTimerID);
        }
    }

    if (hitTarget) {
        pself->MGBI_lastShotState = 1;
        /* Keep the 16-bit score from wrapping; the five-digit HUD can show it. */
        if (pself->MGBI_score <= 65520) {
            pself->MGBI_score += 10;
        }
    } else {
        pself->MGBI_lastShotState = 2;
        /* The HUD is two digits wide, so saturate the miss count at 99. */
        if (pself->MGBI_misses < 99) {
            pself->MGBI_misses++;
        }
    }

    @send self::MSG_VIS_INVALIDATE();
    retVal->flags = MRF_PROCESSED;
}

/* Animate only birds that have been hit. The falling sprite descends into
 * the grass, remains hidden briefly, then returns at a fresh flight position. */
@method MoorGEOSBoardClass, MSG_MOORGEOS_FALL_TICK
{
    byte active = 0;

    if (!pself->MGBI_gameActive) {
        if (pself->MGBI_fallTimerHandle) {
            TimerStop(pself->MGBI_fallTimerHandle, pself->MGBI_fallTimerID);
            pself->MGBI_fallTimerHandle = 0;
            pself->MGBI_fallTimerID = 0;
        }

        return;
    }

    if (pself->MGBI_screamDelay > 0) {
        pself->MGBI_screamDelay--;
        if (pself->MGBI_screamDelay == 0) {
            if (MoorGEOSScream == NullHandle) {
                SoundAllocMusicNote(IP_CHOIR_AAHS, 0, HIGH_A,
                                    DYNAMIC_FFF, SSDTT_TEMPO, QUARTER,
                                    &MoorGEOSScream);
            }
            if (MoorGEOSScream != NullHandle) {
                UserStandardSound(SST_CUSTOM_SOUND, MoorGEOSScream, 1);
            }
        }
    }

    if (pself->MGBI_bird0State == 1) {
        pself->MGBI_bird0Y += 18;
        if (pself->MGBI_bird0Y >= 148) {
            pself->MGBI_bird0Y = 148;
            pself->MGBI_bird0State = 2;
            pself->MGBI_bird0Respawn = 0;
        }
    } else if (pself->MGBI_bird0State == 2) {
        if (++pself->MGBI_bird0Respawn >= 5) {
            if (pself->MGBI_bird0Right) {
                pself->MGBI_bird0X = 330; pself->MGBI_bird0Y = 42;
                pself->MGBI_bird0Right = 0;
            } else {
                pself->MGBI_bird0X = 18; pself->MGBI_bird0Y = 82;
                pself->MGBI_bird0Right = 1;
            }
            pself->MGBI_bird0Down = 1;
            pself->MGBI_bird0State = 0;
            pself->MGBI_bird0Respawn = 0;
        }
    }
    if (pself->MGBI_bird0State != 0) active = 1;

    if (pself->MGBI_bird1State == 1) {
        pself->MGBI_bird1Y += 18;
        if (pself->MGBI_bird1Y >= 148) {
            pself->MGBI_bird1Y = 148;
            pself->MGBI_bird1State = 2;
            pself->MGBI_bird1Respawn = 0;
        }
    } else if (pself->MGBI_bird1State == 2) {
        if (++pself->MGBI_bird1Respawn >= 5) {
            if (pself->MGBI_bird1Right) {
                pself->MGBI_bird1X = 22; pself->MGBI_bird1Y = 54;
                pself->MGBI_bird1Right = 0;
            } else {
                pself->MGBI_bird1X = 326; pself->MGBI_bird1Y = 94;
                pself->MGBI_bird1Right = 1;
            }
            pself->MGBI_bird1Down = 1;
            pself->MGBI_bird1State = 0;
            pself->MGBI_bird1Respawn = 0;
        }
    }
    if (pself->MGBI_bird1State != 0) active = 1;

    if (pself->MGBI_bird2State == 1) {
        pself->MGBI_bird2Y += 18;
        if (pself->MGBI_bird2Y >= 148) {
            pself->MGBI_bird2Y = 148;
            pself->MGBI_bird2State = 2;
            pself->MGBI_bird2Respawn = 0;
        }
    } else if (pself->MGBI_bird2State == 2) {
        if (++pself->MGBI_bird2Respawn >= 5) {
            if (pself->MGBI_bird2Right) {
                pself->MGBI_bird2X = 310; pself->MGBI_bird2Y = 36;
                pself->MGBI_bird2Right = 0;
            } else {
                pself->MGBI_bird2X = 34; pself->MGBI_bird2Y = 98;
                pself->MGBI_bird2Right = 1;
            }
            pself->MGBI_bird2Down = 1;
            pself->MGBI_bird2State = 0;
            pself->MGBI_bird2Respawn = 0;
        }
    }
    if (pself->MGBI_bird2State != 0) active = 1;

    if (!active && pself->MGBI_fallTimerHandle) {
        TimerStop(pself->MGBI_fallTimerHandle, pself->MGBI_fallTimerID);
        pself->MGBI_fallTimerHandle = 0;
        pself->MGBI_fallTimerID = 0;
    }
    @send self::MSG_VIS_INVALIDATE();

}

/* Move each chicken across the field once per second, then update the clock. */
@method MoorGEOSBoardClass, MSG_MOORGEOS_TIMER_TICK
{
    if (pself->MGBI_gameActive && pself->MGBI_secondsLeft > 0) {
        if (pself->MGBI_bird0State == 0) {
        if (pself->MGBI_bird0Right) {
            if (pself->MGBI_bird0X >= 312) {
                pself->MGBI_bird0X = 348;
                pself->MGBI_bird0Right = 0;
            } else {
                pself->MGBI_bird0X += 36;
            }
        } else if (pself->MGBI_bird0X <= 44) {
            pself->MGBI_bird0X = 8;
            pself->MGBI_bird0Right = 1;
        } else {
            pself->MGBI_bird0X -= 36;
        }
        if (pself->MGBI_bird0Down) {
            if (pself->MGBI_bird0Y >= 94) {
                pself->MGBI_bird0Y = 108;
                pself->MGBI_bird0Down = 0;
            } else {
                pself->MGBI_bird0Y += 14;
            }
        } else if (pself->MGBI_bird0Y <= 42) {
            pself->MGBI_bird0Y = 32;
            pself->MGBI_bird0Down = 1;
        } else {
            pself->MGBI_bird0Y -= 14;
        }
        }

        if (pself->MGBI_bird1State == 0) {
        if (pself->MGBI_bird1Right) {
            if (pself->MGBI_bird1X >= 318) {
                pself->MGBI_bird1X = 348;
                pself->MGBI_bird1Right = 0;
            } else {
                pself->MGBI_bird1X += 30;
            }
        } else if (pself->MGBI_bird1X <= 36) {
            pself->MGBI_bird1X = 6;
            pself->MGBI_bird1Right = 1;
        } else {
            pself->MGBI_bird1X -= 30;
        }
        if (pself->MGBI_bird1Down) {
            if (pself->MGBI_bird1Y >= 92) {
                pself->MGBI_bird1Y = 108;
                pself->MGBI_bird1Down = 0;
            } else {
                pself->MGBI_bird1Y += 16;
            }
        } else if (pself->MGBI_bird1Y <= 48) {
            pself->MGBI_bird1Y = 32;
            pself->MGBI_bird1Down = 1;
        } else {
            pself->MGBI_bird1Y -= 16;
        }
        }

        if (pself->MGBI_bird2State == 0) {
        if (pself->MGBI_bird2Right) {
            if (pself->MGBI_bird2X >= 306) {
                pself->MGBI_bird2X = 348;
                pself->MGBI_bird2Right = 0;
            } else {
                pself->MGBI_bird2X += 42;
            }
        } else if (pself->MGBI_bird2X <= 52) {
            pself->MGBI_bird2X = 10;
            pself->MGBI_bird2Right = 1;
        } else {
            pself->MGBI_bird2X -= 42;
        }
        if (pself->MGBI_bird2Down) {
            if (pself->MGBI_bird2Y >= 96) {
                pself->MGBI_bird2Y = 108;
                pself->MGBI_bird2Down = 0;
            } else {
                pself->MGBI_bird2Y += 12;
            }
        } else if (pself->MGBI_bird2Y <= 44) {
            pself->MGBI_bird2Y = 32;
            pself->MGBI_bird2Down = 1;
        } else {
            pself->MGBI_bird2Y -= 12;
        }
        }
        pself->MGBI_secondsLeft--;
        if (pself->MGBI_secondsLeft == 0) {
            pself->MGBI_gameActive = 0;
            pself->MGBI_gameFinished = 1;

            pself->MGBI_crosshairVisible = 0;
            @call MoorGEOSView::MSG_GEN_VIEW_SET_PTR_IMAGE(NullOptr, PIL_WINDOW);

            TimerStop(pself->MGBI_timerHandle, pself->MGBI_timerID);
            pself->MGBI_timerHandle = 0;
            pself->MGBI_timerID = 0;
            if (pself->MGBI_fallTimerHandle) {
                TimerStop(pself->MGBI_fallTimerHandle, pself->MGBI_fallTimerID);
                pself->MGBI_fallTimerHandle = 0;
                pself->MGBI_fallTimerID = 0;
            }
        }
        @send self::MSG_VIS_INVALIDATE();
    }
}

/* Reset all prototype state when the user chooses Spiel > Neues Spiel. */
@method MoorGEOSBoardClass, MSG_MOORGEOS_NEW_GAME
{
    pself->MGBI_score = 0;
    pself->MGBI_misses = 0;
    pself->MGBI_secondsLeft = 60;
    pself->MGBI_bird0X = 28;
    pself->MGBI_bird1X = 174;
    pself->MGBI_bird2X = 320;
    pself->MGBI_bird0Right = 1;
    pself->MGBI_bird1Right = 0;
    pself->MGBI_bird2Right = 1;
    pself->MGBI_bird0Y = 66;
    pself->MGBI_bird1Y = 82;
    pself->MGBI_bird2Y = 56;
    pself->MGBI_bird0Down = 1;
    pself->MGBI_bird1Down = 0;
    pself->MGBI_bird2Down = 1;
    pself->MGBI_bird0State = 0;
    pself->MGBI_bird1State = 0;
    pself->MGBI_bird2State = 0;
    pself->MGBI_bird0Respawn = 0;
    pself->MGBI_bird1Respawn = 0;
    pself->MGBI_bird2Respawn = 0;
    pself->MGBI_screamDelay = 0;
    pself->MGBI_gameActive = 0;
    pself->MGBI_gameFinished = 0;
    pself->MGBI_lastShotState = 0;

    /* A new round starts without the app-drawn crosshair. */
    pself->MGBI_crosshairVisible = 0;
    @call MoorGEOSView::MSG_GEN_VIEW_SET_PTR_IMAGE(NullOptr, PIL_WINDOW);
    if (pself->MGBI_timerHandle) {
        TimerStop(pself->MGBI_timerHandle, pself->MGBI_timerID);
        pself->MGBI_timerHandle = 0;
        pself->MGBI_timerID = 0;
    }
    if (pself->MGBI_fallTimerHandle) {
        TimerStop(pself->MGBI_fallTimerHandle, pself->MGBI_fallTimerID);
        pself->MGBI_fallTimerHandle = 0;
        pself->MGBI_fallTimerID = 0;
    }

    @send self::MSG_VIS_INVALIDATE();
}
