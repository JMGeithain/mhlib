@object MoorGEOSBoardClass MoorGEOSBoard = {
    VI_bounds = {0, 0, 400, 260};
}

@end BoardBlock;

/*
 * Draw the playfield and the imported Moorhuhn bitmap sprite.
 */
@method MoorGEOSBoardClass, MSG_VIS_DRAW
{
    word birdX;
    word birdY;
    byte birdIndex;
    void *birdGraphicData;
    Handle birdGString;

    GrSetMixMode(gstate, MM_COPY);

    /* Sky and grass. */
    GrSetAreaColor(gstate, CF_INDEX, C_CYAN, 0, 0);
    GrFillRect(gstate, 0, 0, 399, 159);

    GrSetAreaColor(gstate, CF_INDEX, C_GREEN, 0, 0);
    GrFillRect(gstate, 0, 160, 399, 259);

    /* A simple sun and two ground lines make the scene easier to read. */
    GrSetAreaColor(gstate, CF_INDEX, C_YELLOW, 0, 0);
    GrFillEllipse(gstate, 290, 50, 317, 77);

    GrSetLineColor(gstate, CF_INDEX, C_GREEN, 0, 0);
    GrDrawHLine(gstate, 0, 168, 399);
    GrDrawHLine(gstate, 0, 214, 399);

    /* Give the three HUD rows clear spacing and padding on every side. */
    GrSetAreaColor(gstate, CF_INDEX, C_BLACK, 0, 0);
    GrFillRect(gstate, 4, 4, 132, 55);
    GrSetTextColor(gstate, CF_INDEX, C_WHITE, 0, 0);
    GrDrawText(gstate, 10, 10, "Punkte", 6);
    GrDrawText(gstate, 10, 26, "Fehler", 6);
    GrDrawText(gstate, 10, 42, "Zeit", 4);
    {
        word i;
        word scoreValue = pself->MGBI_score;
        word missesValue = pself->MGBI_misses;
        word secondsValue = pself->MGBI_secondsLeft;
        char digitText[2];
        /* Five score digits, including leading zeroes, fit inside the panel. */
        GrSetTextColor(gstate, CF_INDEX, C_YELLOW, 0, 0);
        for (i = 0; i < 5; i++) {
            word divisor = 1;
            word j;
            for (j = i + 1; j < 5; j++) divisor *= 10;
            digitText[0] = '0' + ((scoreValue / divisor) % 10);
            digitText[1] = 0;
            GrDrawText(gstate, 76 + (i * 8), 10, digitText, 1);
        }
        /* Miss count is capped visually at 99 to keep the panel compact. */
        if (missesValue > 99) missesValue = 99;
        GrSetTextColor(gstate, CF_INDEX, C_LIGHT_RED, 0, 0);
        digitText[0] = '0' + ((missesValue / 10) % 10);
        digitText[1] = 0;
        GrDrawText(gstate, 76, 26, digitText, 1);
        digitText[0] = '0' + (missesValue % 10);
        GrDrawText(gstate, 84, 26, digitText, 1);
        GrSetTextColor(gstate, CF_INDEX, C_WHITE, 0, 0);
        digitText[0] = '0' + ((secondsValue / 10) % 10);
        GrDrawText(gstate, 76, 42, digitText, 1);
        digitText[0] = '0' + (secondsValue % 10);
        GrDrawText(gstate, 84, 42, digitText, 1);
    }

    /* Load, draw, and release a fresh GString for each chicken. */
    for (birdIndex = 0; birdIndex < 3; birdIndex++) {
        switch (birdIndex) {
            case 0: birdX = pself->MGBI_bird0X; birdY = pself->MGBI_bird0Y; break;
            case 1: birdX = pself->MGBI_bird1X; birdY = pself->MGBI_bird1Y; break;
            default: birdX = pself->MGBI_bird2X; birdY = pself->MGBI_bird2Y; break;
        }
        birdGraphicData = LMemDerefHandles(OptrToHandle(oself), @MoorGEOSBirdGraphic);
        birdGString = GrLoadGString(PtrToSegment(birdGraphicData), GST_PTR,
                                      PtrToOffset(birdGraphicData));
        GrDrawGString(gstate, birdGString, birdX, birdY, 0, (word*)0);
        GrDestroyGString(birdGString, 0, GSKT_LEAVE_DATA);
    }

    /* Context message: show the player how to start or restart. */
    if (!pself->MGBI_gameActive && !pself->MGBI_gameFinished) {
        GrSetAreaColor(gstate, CF_INDEX, C_BLACK, 0, 0);
        GrFillRect(gstate, 100, 225, 300, 245);
        GrSetTextColor(gstate, CF_INDEX, C_WHITE, 0, 0);
        GrDrawText(gstate, 118, 232, "KLICK ZUM START", 15);
    } else if (pself->MGBI_gameActive && pself->MGBI_lastShotState != 0) {
        GrSetAreaColor(gstate, CF_INDEX, C_BLACK, 0, 0);
        GrFillRect(gstate, 142, 225, 258, 245);
        if (pself->MGBI_lastShotState == 1) {
            GrSetTextColor(gstate, CF_INDEX, C_YELLOW, 0, 0);
            GrDrawText(gstate, 166, 232, "TREFFER!", 8);
        } else {
            GrSetTextColor(gstate, CF_INDEX, C_LIGHT_RED, 0, 0);
            GrDrawText(gstate, 168, 232, "DANEBEN", 7);
        }
    }

    /* Clear end-of-round message over the playfield when the clock expires. */
    if (pself->MGBI_gameFinished) {
        GrSetAreaColor(gstate, CF_INDEX, C_BLACK, 0, 0);
        GrFillRect(gstate, 130, 188, 270, 212);
        GrSetTextColor(gstate, CF_INDEX, C_WHITE, 0, 0);
        GrDrawText(gstate, 144, 195, "SPIEL VORBEI", 12);
        GrDrawText(gstate, 118, 232, "NEUES SPIEL IM MENUE", 19);
    }

    @callsuper();
}

/* Start the round clock only once the player first clicks the board. */
@method MoorGEOSBoardClass, MSG_META_START_SELECT
{
    byte hitTarget = 0;

    if (pself->MGBI_gameFinished) {
        retVal->flags = MRF_PROCESSED;
        return;
    }

    if (!pself->MGBI_gameActive) {
        pself->MGBI_gameActive = 1;
        pself->MGBI_secondsLeft = 60;
        pself->MGBI_timerHandle = TimerStart(
            TIMER_EVENT_CONTINUAL, oself, 60,
            MSG_MOORGEOS_TIMER_TICK, 60,
            &pself->MGBI_timerID);
    }

    /* Check the current 52x70 rectangle of each moving sprite. */
    if (((xPosition >= pself->MGBI_bird0X) &&
         (xPosition <= pself->MGBI_bird0X + 51) &&
         (yPosition >= pself->MGBI_bird0Y) &&
         (yPosition <= pself->MGBI_bird0Y + 69)) ||
        ((xPosition >= pself->MGBI_bird1X) &&
         (xPosition <= pself->MGBI_bird1X + 51) &&
         (yPosition >= pself->MGBI_bird1Y) &&
         (yPosition <= pself->MGBI_bird1Y + 69)) ||
        ((xPosition >= pself->MGBI_bird2X) &&
         (xPosition <= pself->MGBI_bird2X + 51) &&
         (yPosition >= pself->MGBI_bird2Y) &&
         (yPosition <= pself->MGBI_bird2Y + 69))) {
        hitTarget = 1;
    }

    if (hitTarget) {
        pself->MGBI_lastShotState = 1;
        /* Keep the 16-bit score from wrapping; the five-digit HUD can show it. */
        if (pself->MGBI_score <= 65520) {
            pself->MGBI_score += 10;
        }
    } else {
        pself->MGBI_lastShotState = 2;
        /* The HUD is two digits wide, so saturate the miss count at 99. */
        if (pself->MGBI_misses < 99) {
            pself->MGBI_misses++;
        }
    }

    @send self::MSG_VIS_INVALIDATE();
    retVal->flags = MRF_PROCESSED;
}

/* Move each chicken across the field once per second, then update the clock. */
@method MoorGEOSBoardClass, MSG_MOORGEOS_TIMER_TICK
{
    if (pself->MGBI_gameActive && pself->MGBI_secondsLeft > 0) {
        if (pself->MGBI_bird0Right) {
            if (pself->MGBI_bird0X >= 312) {
                pself->MGBI_bird0X = 348;
                pself->MGBI_bird0Right = 0;
            } else {
                pself->MGBI_bird0X += 36;
            }
        } else if (pself->MGBI_bird0X <= 44) {
            pself->MGBI_bird0X = 8;
            pself->MGBI_bird0Right = 1;
        } else {
            pself->MGBI_bird0X -= 36;
        }
        if (pself->MGBI_bird0Down) {
            if (pself->MGBI_bird0Y >= 80) {
                pself->MGBI_bird0Y = 88;
                pself->MGBI_bird0Down = 0;
            } else {
                pself->MGBI_bird0Y += 8;
            }
        } else if (pself->MGBI_bird0Y <= 56) {
            pself->MGBI_bird0Y = 48;
            pself->MGBI_bird0Down = 1;
        } else {
            pself->MGBI_bird0Y -= 8;
        }

        if (pself->MGBI_bird1Right) {
            if (pself->MGBI_bird1X >= 318) {
                pself->MGBI_bird1X = 348;
                pself->MGBI_bird1Right = 0;
            } else {
                pself->MGBI_bird1X += 30;
            }
        } else if (pself->MGBI_bird1X <= 36) {
            pself->MGBI_bird1X = 6;
            pself->MGBI_bird1Right = 1;
        } else {
            pself->MGBI_bird1X -= 30;
        }
        if (pself->MGBI_bird1Down) {
            if (pself->MGBI_bird1Y >= 78) {
                pself->MGBI_bird1Y = 88;
                pself->MGBI_bird1Down = 0;
            } else {
                pself->MGBI_bird1Y += 10;
            }
        } else if (pself->MGBI_bird1Y <= 58) {
            pself->MGBI_bird1Y = 48;
            pself->MGBI_bird1Down = 1;
        } else {
            pself->MGBI_bird1Y -= 10;
        }

        if (pself->MGBI_bird2Right) {
            if (pself->MGBI_bird2X >= 306) {
                pself->MGBI_bird2X = 348;
                pself->MGBI_bird2Right = 0;
            } else {
                pself->MGBI_bird2X += 42;
            }
        } else if (pself->MGBI_bird2X <= 52) {
            pself->MGBI_bird2X = 10;
            pself->MGBI_bird2Right = 1;
        } else {
            pself->MGBI_bird2X -= 42;
        }
        if (pself->MGBI_bird2Down) {
            if (pself->MGBI_bird2Y >= 82) {
                pself->MGBI_bird2Y = 88;
                pself->MGBI_bird2Down = 0;
            } else {
                pself->MGBI_bird2Y += 6;
            }
        } else if (pself->MGBI_bird2Y <= 54) {
            pself->MGBI_bird2Y = 48;
            pself->MGBI_bird2Down = 1;
        } else {
            pself->MGBI_bird2Y -= 6;
        }

        pself->MGBI_secondsLeft--;
        if (pself->MGBI_secondsLeft == 0) {
            pself->MGBI_gameActive = 0;
            pself->MGBI_gameFinished = 1;
            TimerStop(pself->MGBI_timerHandle, pself->MGBI_timerID);
            pself->MGBI_timerHandle = 0;
            pself->MGBI_timerID = 0;
        }
        @send self::MSG_VIS_INVALIDATE();
    }
}

/* Reset all prototype state when the user chooses Spiel > Neues Spiel. */
@method MoorGEOSBoardClass, MSG_MOORGEOS_NEW_GAME
{
    pself->MGBI_score = 0;
    pself->MGBI_misses = 0;
    pself->MGBI_secondsLeft = 60;
    pself->MGBI_bird0X = 28;
    pself->MGBI_bird1X = 174;
    pself->MGBI_bird2X = 320;
    pself->MGBI_bird0Y = 66;
    pself->MGBI_bird1Y = 82;
    pself->MGBI_bird2Y = 56;
    pself->MGBI_bird0Right = 1;
    pself->MGBI_bird1Right = 0;
    pself->MGBI_bird2Right = 1;
    pself->MGBI_bird0Down = 1;
    pself->MGBI_bird1Down = 0;
    pself->MGBI_bird2Down = 1;
    pself->MGBI_gameActive = 0;
    pself->MGBI_gameFinished = 0;
    pself->MGBI_lastShotState = 0;
    if (pself->MGBI_timerHandle) {
        TimerStop(pself->MGBI_timerHandle, pself->MGBI_timerID);
        pself->MGBI_timerHandle = 0;
        pself->MGBI_timerID = 0;
    }

    @send self::MSG_VIS_INVALIDATE();
}
