/*
 * MOORGEOS - native FreeGEOS prototype.
 *
 * Stage 2: move the scene into a GenView/VisContent tree and receive
 * mouse-select events on the board. Build with the FreeGEOS SDK; see ANLEITUNG.txt for local build steps.
 */

@include <stdapp.goh>
#include <graphics.h>
#include <gstring.h>
#include <timer.h>
@include "moorgeos.goh"

@class MoorGEOSProcessClass, GenProcessClass;
@endc
@classdecl MoorGEOSProcessClass, neverSaved;
@classdecl MoorGEOSBoardClass;

@start AppResource;

@object GenApplicationClass MoorGEOSApp = {
    /* The UI chooses a suitable moniker from this list for its display. */
    GI_visMoniker = list {
        @MoorGEOSTitle,
        @MoorGEOSIconLarge,
        @MoorGEOSIconSmall
    };
    GI_comp = @MoorGEOSPrimary;
    gcnList(MANUFACTURER_ID_GEOWORKS, GAGCNLT_WINDOWS) = @MoorGEOSPrimary;
}

@visMoniker MoorGEOSTitle = "GeoMoorhuhn lite";

@end AppResource;

@start AppMonikerResource, data;
@include "moorgeosicons.goh"
@include "moorgeosaboutlogo.goh"
@end AppMonikerResource;

@start Interface;

@object GenPrimaryClass MoorGEOSPrimary = {
    GI_comp = @MoorGEOSView, @MoorGEOSGameMenu, @MoorGEOSAboutDialog;
    GI_visMoniker = list { @MoorGEOSTitle, @MoorGEOSIconSmall };
    HINT_SIZE_WINDOW_AS_DESIRED;
    HINT_PRIMARY_NO_FILE_MENU;
}

@object GenViewClass MoorGEOSView = {
    GVI_content = MoorGEOSBoard;
    GVI_docBounds = {0, 0, 400, 260};
    GVI_color = { C_CYAN, 0, 0, 0 };
    GVI_horizAttrs = @default | GVDA_NO_LARGER_THAN_CONTENT
                               | GVDA_NO_SMALLER_THAN_CONTENT;
    GVI_vertAttrs = @default | GVDA_NO_LARGER_THAN_CONTENT
                             | GVDA_NO_SMALLER_THAN_CONTENT
                             | GVDA_KEEP_ASPECT_RATIO;
    ATTR_GEN_VIEW_DOES_NOT_ACCEPT_TEXT_INPUT;
}

@object GenInteractionClass MoorGEOSGameMenu = {
    GI_visMoniker = 'S', "Spiel";
    GI_comp = @MoorGEOSNewGame, @MoorGEOSAboutTrigger, @MoorGEOSQuit;
    GII_visibility = GIV_POPUP;
}

@object GenTriggerClass MoorGEOSQuit = {
    GI_visMoniker = 'B', "Beenden";
    GTI_destination = @MoorGEOSApp;
    GTI_actionMsg = MSG_META_QUIT;
}

@object GenTriggerClass MoorGEOSAboutTrigger = {
    GI_visMoniker = 'I', "Info \x9F\142er GeoMoorhuhn lite";
    GTI_destination = @MoorGEOSAboutDialog;
    GTI_actionMsg = MSG_GEN_INTERACTION_INITIATE;
    HINT_TRIGGER_BRINGS_UP_WINDOW;
}

@object GenInteractionClass MoorGEOSAboutDialog = {
    GI_visMoniker = "Info \x9F\142er GeoMoorhuhn lite";
    GI_comp = @MoorGEOSAboutLine1, @MoorGEOSAboutLine2,
              @MoorGEOSAboutLogoGlyph, @MoorGEOSAboutLine4,
              @MoorGEOSAboutLine5, @MoorGEOSAboutOK;
    GII_visibility = GIV_DIALOG;
    GII_attrs = @default | GIA_MODAL | GIA_NOT_USER_INITIATABLE;
    HINT_CENTER_CHILDREN_HORIZONTALLY;
}

@object GenGlyphClass MoorGEOSAboutLine1 = {
    GI_visMoniker = "GeoMoorhuhn lite";
}
@object GenGlyphClass MoorGEOSAboutLine2 = {
    GI_visMoniker = "Version 0.1";
}
@object GenGlyphClass MoorGEOSAboutLogoGlyph = {
    GI_visMoniker = list { @MoorGEOSAboutLogo };
}
@object GenGlyphClass MoorGEOSAboutLine4 = {
    GI_visMoniker = "2026 \xA9 by M\x9Allerjaner";
}
@object GenGlyphClass MoorGEOSAboutLine5 = {
    GI_visMoniker = "Johannes M\x9Aller, Syhra";
}
@object GenTriggerClass MoorGEOSAboutOK = {
    GI_visMoniker = "OK";
    GI_attrs = @default | GA_SIGNAL_INTERACTION_COMPLETE;
    HINT_SEEK_REPLY_BAR;
    HINT_DEFAULT_DEFAULT_ACTION;
}
@object GenTriggerClass MoorGEOSNewGame = {
    GI_visMoniker = 'N', "Neues Spiel";
    GTI_destination = MoorGEOSBoard;
    GTI_actionMsg = MSG_MOORGEOS_NEW_GAME;
}

@end Interface;

@start BoardBlock;

